{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL"]
    },
    "test:live": {
      "env": ["DATABASE_URL", "REDIS_URL", "ANTHROPIC_API_KEY", "AI_USE_LIVE"]
    },
    "db:generate": {},
    "db:migrate": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:fix-jsonb-double-encoding": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
