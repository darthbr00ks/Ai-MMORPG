# Database
DATABASE_URL=<postgres-connection-string>

# Redis
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (only needed when AI_USE_LIVE=true)
ANTHROPIC_API_KEY=

# AI Settings
AI_USE_LIVE=false
AI_DECISION_MODEL=claude-haiku-4-5
AI_DIALOGUE_MODEL=claude-sonnet-5
AI_SUMMARY_MODEL=claude-sonnet-5
AI_PREMIUM_ENABLED=false
AI_DAILY_BUDGET_CENTS=500

# Game Settings
# These two are dev-fast values (§12) so a "day" is watchable in
# minutes. Production (see fly.web.toml / fly.worker.toml) uses
# GAME_DAY_REAL_SECONDS=86400 / SIMULATION_TICK_SECONDS=1800 (a real
# day, 48 ticks/day) — set BOTH apps to the same values, or the web
# app's game-time display (e.g. /admin's "Game day") will disagree
# with what the worker is actually doing.
GAME_DAY_REAL_SECONDS=300
SIMULATION_TICK_SECONDS=10
DIRECTIVE_MAX_CHARACTERS=500
DEFAULT_STARTING_CURRENCY_CENTS=10000

# Web
NEXTAUTH_URL=http://localhost:3000
