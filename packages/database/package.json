{
  "name": "@ai-world/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:fix-jsonb-double-encoding": "tsx src/fix-jsonb-double-encoding.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.31.2",
    "postgres": "^3.4.4",
    "@ai-world/shared": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.22.7",
    "typescript": "^5.4.5",
    "tsx": "^4.15.0",
    "@types/node": "^20.14.0"
  }
}
